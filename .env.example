# LaBuBu's Balance Lab - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ===========================
# Application
# ===========================

# Node environment (development | production | test)
NODE_ENV=development

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base URL (if separate backend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================
# Database
# ===========================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://labubu:password@localhost:5432/labubu_dev

# Database connection pool size
DATABASE_POOL_SIZE=10

# ===========================
# Authentication
# ===========================

# JWT secret for session tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here

# Session expiration (in seconds)
SESSION_EXPIRY=86400

# OAuth providers (for school SSO)

# Google OAuth (Google Classroom integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Clever SSO
CLEVER_CLIENT_ID=your-clever-client-id
CLEVER_CLIENT_SECRET=your-clever-client-secret
CLEVER_REDIRECT_URI=http://localhost:3000/api/auth/callback/clever

# ClassLink SSO
CLASSLINK_CLIENT_ID=your-classlink-client-id
CLASSLINK_CLIENT_SECRET=your-classlink-client-secret
CLASSLINK_REDIRECT_URI=http://localhost:3000/api/auth/callback/classlink

# ===========================
# Email & Notifications
# ===========================

# SMTP server for email notifications (progress reports, reminders)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@labubu.app
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=LaBuBu's Balance Lab
SMTP_FROM_EMAIL=noreply@labubu.app

# SMS provider (Twilio for optional SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# ===========================
# Cloud Storage
# ===========================

# AWS S3 (for character animations, student work, exports)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=labubu-assets

# Cloudinary (alternative for media storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================
# Analytics & Monitoring
# ===========================

# Sentry (error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# LogRocket (session replay - optional)
LOGROCKET_APP_ID=your-logrocket-app-id

# Privacy-respecting analytics (e.g., Plausible, Fathom)
PLAUSIBLE_DOMAIN=labubu.app
PLAUSIBLE_API_KEY=your-plausible-api-key

# ===========================
# Feature Flags
# ===========================

# Enable/disable features during development
FEATURE_MULTIPLAYER=false
FEATURE_VOICE_INPUT=false
FEATURE_AR_MODE=false
FEATURE_PARENT_PORTAL=true
FEATURE_TEACHER_PORTAL=true

# ===========================
# AI & Text-to-Speech
# ===========================

# OpenAI (for future features: adaptive hints, content generation)
OPENAI_API_KEY=your-openai-api-key

# Text-to-Speech provider (for Gator's voice, passage reading)
# Options: Google Cloud TTS, Amazon Polly, ElevenLabs
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=your-google-tts-api-key

# Speech-to-Text (for voice input answers)
STT_PROVIDER=google
GOOGLE_STT_API_KEY=your-google-stt-api-key

# ===========================
# Rate Limiting & Security
# ===========================

# Redis (for session management, caching, rate limiting)
REDIS_URL=redis://localhost:6379

# Rate limiting (requests per minute)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://labubu.app

# Content Security Policy (CSP) report URI
CSP_REPORT_URI=https://your-csp-report-endpoint.com

# ===========================
# LMS Integration
# ===========================

# Google Classroom
GOOGLE_CLASSROOM_API_KEY=your-classroom-api-key

# Canvas LMS
CANVAS_API_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=your-canvas-token

# Schoology
SCHOOLOGY_CONSUMER_KEY=your-schoology-consumer-key
SCHOOLOGY_CONSUMER_SECRET=your-schoology-consumer-secret

# ===========================
# Compliance & Privacy
# ===========================

# Data encryption key (for PII in database)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-data-encryption-key

# FERPA compliance mode (strict data handling)
FERPA_MODE=true

# Consent management
REQUIRE_PARENTAL_CONSENT=true
CONSENT_AGE_THRESHOLD=13

# ===========================
# Development Tools
# ===========================

# Debug mode (verbose logging)
DEBUG=false

# Enable GraphQL playground (development only)
GRAPHQL_PLAYGROUND=true

# Seed database with test data
SEED_DATABASE=false

# ===========================
# Performance
# ===========================

# CDN URL (for static assets in production)
CDN_URL=https://cdn.labubu.app

# Image optimization service
IMAGE_OPTIMIZATION=true

# Service worker caching strategy
SW_CACHE_STRATEGY=network-first

# ===========================
# Webhooks (for integrations)
# ===========================

# Webhook secret for validating incoming requests
WEBHOOK_SECRET=your-webhook-secret

# ===========================
# Testing
# ===========================

# Test database URL (separate from development DB)
TEST_DATABASE_URL=postgresql://labubu:password@localhost:5432/labubu_test

# Disable emails during tests
TEST_DISABLE_EMAILS=true

# ===========================
# Notes for Developers
# ===========================

# IMPORTANT:
# - Copy this file to .env before running the application
# - NEVER commit .env to version control (.gitignore blocks it)
# - Generate strong secrets for JWT_SECRET and DATA_ENCRYPTION_KEY
# - Use different credentials for development, staging, and production
# - Rotate secrets regularly (especially in production)
# - Student PII must be encrypted at rest (use DATA_ENCRYPTION_KEY)
# - Follow FERPA guidelines for all student data handling

# For production deployment:
# - Use environment variable management (Vercel, AWS Secrets Manager, etc.)
# - Enable HTTPS only
# - Set CORS_ALLOWED_ORIGINS to your production domain
# - Enable rate limiting and security headers
# - Configure Sentry for error tracking
# - Use managed database service (RDS, Supabase, PlanetScale, etc.)
